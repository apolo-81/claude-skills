{
  "permissions": {
    "allow": [
      "Read(/home/apolo/.claude/plugins/cache/superpowers-marketplace/**)",
      "Read(/home/apolo/.claude/plugins/cache/claude-code-workflows/**)",
      "Read(/home/apolo/.claude/plugins/**)",
      "Read(/home/apolo/.claude/**)"
    ],
    "defaultMode": "dontAsk"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "obsidian",
    "supabase",
    "openspace"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/apolo/.claude/hooks/compact-claude-md.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/apolo/Documents/sync-all.sh 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Sincronizando vault...",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/apolo/Documents/sync-all.sh 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Sincronizando vault y proyectos..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/apolo/.claude/statusline-command.sh"
  },
