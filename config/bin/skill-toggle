#!/usr/bin/env bash
set -euo pipefail

# skill-toggle - activa/desactiva skills de Claude Code por grupo.
# La fuente de verdad vive en claude-skills/config/bin/skill-toggle.

SKILLS_DIR="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"

unset GROUPS
declare -A GROUPS

GROUPS[default]="app-audit ux-audit claude-config-maintenance market auth-patterns background-jobs brevo-marketing bunny-cdn deployment error-monitoring express-api form-handling ghl-integration landing-page-builder llm-streaming-app ollama-local performance-next prisma-orm saas-boilerplate supabase-stack testing-patterns wa-baileys web-animations webhook-integration"
GROUPS[market]="market market-ads market-audit market-brand market-competitors market-copy market-emails market-funnel market-landing market-launch market-proposal market-report market-report-pdf market-social"
GROUPS[dev]="auth-patterns background-jobs brevo-marketing bunny-cdn deployment render-deployment error-monitoring express-api form-handling ghl-integration llm-streaming-app multi-tenant-patterns mysql-better-sqlite ollama-local performance-next prisma-orm saas-boilerplate supabase-stack testing-patterns wa-baileys webhook-integration infoproduct-funnel tracking-analytics stripe-checkout-onetime"
GROUPS[design]="landing-page-builder web-animations market-visual-identity pro-presentations data-viz-dashboard calendar-master"
GROUPS[content]="chatbot-widget cms-integration email-templates-builder pdf-generation pwa-patterns"
GROUPS[n8n]="n8n-ai-agents n8n-to-api"
GROUPS[seo]="seo-core seo-content-onpage seo-international seo-strategy seo-assets"
GROUPS[maintenance]="app-audit ux-audit claude-config-maintenance obsidian-vault-mgmt"
GROUPS[all]="${GROUPS[maintenance]} ${GROUPS[market]} ${GROUPS[dev]} ${GROUPS[design]} ${GROUPS[content]} ${GROUPS[n8n]} ${GROUPS[seo]}"

GROUP_ORDER=(default maintenance market dev design content n8n seo)

green=$'\033[0;32m'
red=$'\033[0;31m'
yellow=$'\033[1;33m'
blue=$'\033[0;34m'
reset=$'\033[0m'

unique_words() {
  awk '{
    for (i = 1; i <= NF; i++) {
      if (!seen[$i]++) out = out " " $i
    }
  } END { sub(/^ /, "", out); print out }' <<<"$*"
}

skills_for() {
  local target="$1"
  if [[ -n "${GROUPS[$target]:-}" ]]; then
    unique_words "${GROUPS[$target]}"
  elif [[ -d "$SKILLS_DIR/$target" ]]; then
    printf '%s\n' "$target"
  else
    return 1
  fi
}

skill_state() {
  local skill="$1"
  if [[ -f "$SKILLS_DIR/$skill/SKILL.md" ]]; then
    printf 'on'
  elif [[ -f "$SKILLS_DIR/$skill/SKILL.md.off" ]]; then
    printf 'off'
  else
    printf 'missing'
  fi
}

toggle_skill() {
  local skill="$1"
  local action="$2"
  local active="$SKILLS_DIR/$skill/SKILL.md"
  local disabled="$SKILLS_DIR/$skill/SKILL.md.off"

  case "$action" in
    on)
      if [[ -f "$disabled" ]]; then
        mv "$disabled" "$active"
        printf '  %sON %s  %s\n' "$green" "$reset" "$skill"
      elif [[ -f "$active" ]]; then
        printf '  %sON %s  %s (ya estaba on)\n' "$green" "$reset" "$skill"
      else
        printf '  %s???%s  %s (no encontrada)\n' "$yellow" "$reset" "$skill"
      fi
      ;;
    off)
      if [[ -f "$active" ]]; then
        mv "$active" "$disabled"
        printf '  %sOFF%s  %s\n' "$red" "$reset" "$skill"
      elif [[ -f "$disabled" ]]; then
        printf '  %sOFF%s  %s (ya estaba off)\n' "$red" "$reset" "$skill"
      else
        printf '  %s???%s  %s (no encontrada)\n' "$yellow" "$reset" "$skill"
      fi
      ;;
  esac
}

count_totals() {
  local active inactive
  active=$(find "$SKILLS_DIR" -mindepth 2 -maxdepth 2 -name 'SKILL.md' | wc -l)
  inactive=$(find "$SKILLS_DIR" -mindepth 2 -maxdepth 2 -name 'SKILL.md.off' | wc -l)
  printf '%s activas / %s inactivas' "$active" "$inactive"
}

show_group_status() {
  local group="$1"
  local skills on=0 off=0 missing=0 state
  skills=$(skills_for "$group") || {
    printf '%sError:%s grupo o skill desconocido: %s\n' "$red" "$reset" "$group"
    return 1
  }

  printf '%s[%s]%s\n' "$blue" "$group" "$reset"
  for skill in $skills; do
    state=$(skill_state "$skill")
    case "$state" in
      on)      printf '  %sON %s  %s\n' "$green" "$reset" "$skill"; ((on++)) || true ;;
      off)     printf '  %sOFF%s  %s\n' "$red" "$reset" "$skill"; ((off++)) || true ;;
      missing) printf '  %s???%s  %s (no encontrada)\n' "$yellow" "$reset" "$skill"; ((missing++)) || true ;;
    esac
  done
  printf '  %s%s on%s / %s%s off%s' "$green" "$on" "$reset" "$red" "$off" "$reset"
  if [[ "$missing" -gt 0 ]]; then
    printf ' / %s%s missing%s' "$yellow" "$missing" "$reset"
  fi
  printf '\n\n'
}

show_help() {
  cat <<'EOF'
skill-toggle - activar/desactivar skills de Claude Code

Uso:
  skill-toggle status [grupo|skill]
  skill-toggle list
  skill-toggle <grupo|skill> on
  skill-toggle <grupo|skill> off
  skill-toggle profile lean

Grupos: default, maintenance, market, dev, design, content, n8n, seo, all.
EOF
}

apply_profile_lean() {
  local skill
  printf '%sAplicando perfil lean:%s all off -> default on\n' "$yellow" "$reset"
  for skill in $(skills_for all); do
    toggle_skill "$skill" off
  done
  for skill in $(skills_for default); do
    toggle_skill "$skill" on
  done
  printf '\nTotal: %s\n' "$(count_totals)"
}

cmd="${1:-help}"
case "$cmd" in
  help|--help|-h)
    show_help
    ;;
  list)
    printf 'Grupos disponibles:\n'
    for group in "${GROUP_ORDER[@]}" all; do
      printf '  %-8s %s skills\n' "$group" "$(skills_for "$group" | wc -w)"
    done
    ;;
  status)
    if [[ -n "${2:-}" ]]; then
      show_group_status "$2"
    else
      printf 'Total: %s\n\n' "$(count_totals)"
      for group in "${GROUP_ORDER[@]}"; do
        show_group_status "$group"
      done
    fi
    ;;
  profile)
    case "${2:-}" in
      lean) apply_profile_lean ;;
      *) show_help; exit 1 ;;
    esac
    ;;
  *)
    target="$cmd"
    action="${2:-status}"
    if [[ "$action" != "on" && "$action" != "off" && "$action" != "status" ]]; then
      show_help
      exit 1
    fi
    if [[ "$action" = "status" ]]; then
      show_group_status "$target"
      exit $?
    fi
    skills=$(skills_for "$target") || {
      printf '%sError:%s grupo o skill desconocido: %s\n' "$red" "$reset" "$target"
      exit 1
    }
    for skill in $skills; do
      toggle_skill "$skill" "$action"
    done
    printf '\nTotal: %s\n' "$(count_totals)"
    ;;
esac
